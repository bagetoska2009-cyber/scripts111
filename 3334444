-- ==========================================
-- ГЛАВНЫЙ ЦИКЛ РЕНДЕРИНГА (RENDERSTEPPED)
-- ==========================================
local fxAngle = 0
local fpsSmoothed = 60
local lastHUDTick = 0

bindConnection(RunService.RenderStepped, function(dt)
	fxAngle = fxAngle + dt * 2.5
	fpsSmoothed = math.floor(fpsSmoothed * 0.9 + (1 / math.max(dt, 0.001)) * 0.1)

	-- Радужный режим (RGB Theme)
	if S.RainbowMode then
		currentThemeColor = Color3.fromHSV((tick() * 0.22) % 1, 0.85, 1)
		P.BorderColor3 = currentThemeColor
		TB.BorderColor3 = currentThemeColor
		TL.TextColor3 = currentThemeColor
		TelemetryBar.BorderColor3 = currentThemeColor
		TelemetryText.TextColor3 = currentThemeColor
		radarStroke.Color = currentThemeColor
		fovStroke.Color = currentThemeColor
		TargetHUDFrame.BorderColor3 = currentThemeColor
		thudTitle.TextColor3 = currentThemeColor
		if not S.TriggerIndicator then
			chDot.BackgroundColor3 = currentThemeColor
			for _, l in ipairs(chLines) do l.BackgroundColor3 = currentThemeColor end
		end
	else
		currentThemeColor = GREEN
	end

	-- Freecam обновление
	if S.Freecam then
		local moveVec = Vector3.zero
		if not UIS:GetFocusedTextBox() then
			if UIS:IsKeyDown(Enum.KeyCode.W) then moveVec = moveVec + Vector3.new(0, 0, -1) end
			if UIS:IsKeyDown(Enum.KeyCode.S) then moveVec = moveVec + Vector3.new(0, 0, 1) end
			if UIS:IsKeyDown(Enum.KeyCode.A) then moveVec = moveVec + Vector3.new(-1, 0, 0) end
			if UIS:IsKeyDown(Enum.KeyCode.D) then moveVec = moveVec + Vector3.new(1, 0, 0) end
			if UIS:IsKeyDown(Enum.KeyCode.E) or UIS:IsKeyDown(Enum.KeyCode.Space) then moveVec = moveVec + Vector3.new(0, 1, 0) end
			if UIS:IsKeyDown(Enum.KeyCode.Q) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then moveVec = moveVec + Vector3.new(0, -1, 0) end
		end
		
		if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			local delta = UIS:GetMouseDelta()
			freecamAngles = Vector2.new(
				math.clamp(freecamAngles.X - delta.Y * 0.005, -math.rad(89), math.rad(89)),
				freecamAngles.Y - delta.X * 0.005
			)
		else
			UIS.MouseBehavior = Enum.MouseBehavior.Default
		end
		
		local rotCF = CFrame.fromEulerAnglesYXZ(freecamAngles.X, freecamAngles.Y, 0)
		local newPos = freecamCF.Position + (rotCF:VectorToWorldSpace(moveVec) * CFG.FreecamSpeed * dt * 2)
		freecamCF = CFrame.new(newPos) * rotCF
		Camera.CFrame = freecamCF
	end

	if S.CustomFOV then Camera.FieldOfView = CFG.CameraFOV end
	if S.Fullbright then
		Lighting.Brightness = 2.5
		Lighting.FogEnd = 100000
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(185, 185, 185)
	end
	if S.TimeChanger then Lighting.ClockTime = CFG.WorldTime end

	local myChar = getChar()
	local myHead = myChar and myChar:FindFirstChild("Head")
	local myRoot = getRoot()

	-- Троттлинг текстовых HUD (10 раз в секунду)
	local now = tick()
	if now - lastHUDTick > 0.1 then
		lastHUDTick = now
		TelemetryBar.Visible = S.TelemetryHUD
		if S.TelemetryHUD then
			local posStr = myRoot and string.format("%d, %d, %d", math.floor(myRoot.Position.X), math.floor(myRoot.Position.Y), math.floor(myRoot.Position.Z)) or "0, 0, 0"
			local spd = myRoot and math.floor(Vector3.new(myRoot.AssemblyLinearVelocity.X, 0, myRoot.AssemblyLinearVelocity.Z).Magnitude) or 0
			TelemetryText.Text = string.format("FPS: %d | SPD: %d st/s | POS: (%s) | ENTITIES: %d", fpsSmoothed, spd, posStr, #cachedTargetsList)
		end

		InspectorFrame.Visible = S.PartInspector
		if S.PartInspector then
			local t = Mouse.Target
			if t then
				InspectorText.Text = string.format(
					"PART: %s [%s]\nSIZE: (%.1f, %.1f, %.1f)\nMAT: %s | ANCHOR: %s",
					t.Name, t.ClassName, t.Size.X, t.Size.Y, t.Size.Z, tostring(t.Material.Name), tostring(t.Anchored)
				)
			else
				InspectorText.Text = "PART INSPECTOR:\nTarget: [Sky / Void]"
			end
		end
	end

	-- 360 Radar HUD обновление
	RadarFrame.Visible = S.RadarHUD
	if S.RadarHUD and myRoot then
		local targets = getValidTargets(false)
		local camLook = Camera.CFrame.LookVector
		local camYaw = math.atan2(-camLook.X, -camLook.Z)
		local dotIdx = 1

		for _, t in ipairs(targets) do
			if t.RootPart then
				local rel = t.RootPart.Position - myRoot.Position
				local dist2D = Vector2.new(rel.X, rel.Z).Magnitude
				if dist2D <= CFG.RadarRange then
					local angle = math.atan2(rel.X, rel.Z) - camYaw
					local normDist = (dist2D / CFG.RadarRange) * 68
					local px = 75 + math.sin(angle) * normDist
					local py = 75 - math.cos(angle) * normDist

					local dot = radarDotsPool[dotIdx]
					if not dot then
						dot = Instance.new("Frame", RadarFrame)
						dot.Size = UDim2.new(0, 5, 0, 5)
						dot.AnchorPoint = Vector2.new(0.5, 0.5)
						Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
						radarDotsPool[dotIdx] = dot
					end
					dot.Position = UDim2.fromOffset(px, py)
					dot.BackgroundColor3 = t.IsPlayer and CFG.Color_PlayerVisible or CFG.Color_BotVisible
					dot.Visible = true
					dotIdx = dotIdx + 1
				end
			end
		end
		for i = dotIdx, #radarDotsPool do
			if radarDotsPool[i] then radarDotsPool[i].Visible = false end
		end
	end

	-- Обновление 3D эффектов персонажа
	if S.Halo and myHalo and myHead then
		myHalo.CFrame = CFrame.new(myHead.Position + Vector3.new(0, 1.45, 0)) * CFrame.Angles(0, fxAngle, 0)
		if S.RainbowMode then myHalo.Color = currentThemeColor end
	end
	if S.ChinaHat and myChinaHat and myHead then
		myChinaHat.CFrame = CFrame.new(myHead.Position + Vector3.new(0, 1.15, 0)) * CFrame.Angles(0, -fxAngle, 0)
		if S.RainbowMode then myChinaHat.Color = currentThemeColor end
	end
	if S.CyberShield and myCyberShield and myRoot then
		myCyberShield.CFrame = CFrame.new(myRoot.Position) * CFrame.Angles(fxAngle * 0.5, fxAngle, 0)
		if S.RainbowMode then myCyberShield.Color = currentThemeColor end
	end
	if S.OrbitOrbs and myRoot and #myOrbs > 0 then
		for _, orb in ipairs(myOrbs) do
			if orb.Part and orb.Part.Parent then
				local a = fxAngle * 1.4 + orb.Offset
				local offsetPos = Vector3.new(math.cos(a) * 4.2, math.sin(a * 2) * 1.3, math.sin(a) * 4.2)
				orb.Part.Position = myRoot.Position + offsetPos
				if S.RainbowMode then
					orb.Part.Color = currentThemeColor
					orb.Trail.Color = ColorSequence.new(currentThemeColor)
				end
			end
		end
	end
	if S.Pulse and myPulse and S.RainbowMode then
		myPulse.OutlineColor = currentThemeColor
	end

	-- FOV и Прицел
	FOVFrame.Visible = S.Aimbot and CFG.ShowFOV
	if FOVFrame.Visible then
		FOVFrame.Size = UDim2.fromOffset(CFG.AimFOV * 2, CFG.AimFOV * 2)
	end
	
	CustomCrosshair.Visible = S.Crosshair
	if S.Crosshair then
		CustomCrosshair.Rotation = (CustomCrosshair.Rotation + dt * 45) % 360
		if S.TriggerIndicator and Mouse.Target then
			local model = Mouse.Target:FindFirstAncestorOfClass("Model")
			local hum = model and model:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and model ~= myChar then
				chDot.BackgroundColor3 = RED
				for _, l in ipairs(chLines) do l.BackgroundColor3 = RED end
			else
				chDot.BackgroundColor3 = currentThemeColor
				for _, l in ipairs(chLines) do l.BackgroundColor3 = currentThemeColor end
			end
		else
			chDot.BackgroundColor3 = currentThemeColor
			for _, l in ipairs(chLines) do l.BackgroundColor3 = currentThemeColor end
		end
	end

	-- 1. ESP Highlights
	if S.ESP then
		local targets = getValidTargets(CFG.ESP_TeamCheck)
		local activeModels = {}
		for _, target in ipairs(targets) do
			if checkDistance(target.RootPart, CFG.ESP_MaxDist) then
				local model = target.Model
				local visible = isVisible(target.RootPart)
				if not (CFG.ESP_WallCheck and not visible) then
					activeModels[model] = true
					local hl = espHighlights[model]
					if not hl or hl.Parent ~= SG then
						if hl then hl:Destroy() end
						hl = Instance.new("Highlight")
						hl.Name = "BaggetESP"
						hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
						hl.Parent = SG
						espHighlights[model] = hl
					end
					hl.Enabled = true
					hl.Adornee = model
					local col = target.IsPlayer and (visible and CFG.Color_PlayerVisible or CFG.Color_PlayerHidden) or (visible and CFG.Color_BotVisible or CFG.Color_BotHidden)
					hl.FillColor = col
					hl.OutlineColor = col
					hl.FillTransparency = visible and 0.58 or 0.8
				end
			end
		end
		for model, hl in pairs(espHighlights) do
			if not model or not model.Parent or not activeModels[model] then
				if hl then hl:Destroy() end
				espHighlights[model] = nil
			end
		end
	else
		for model, hl in pairs(espHighlights) do
			if hl then hl:Destroy() end
			espHighlights[model] = nil
		end
	end

	-- 2. 2D Box ESP + HealthBar + Name & Distance
	if S.BoxESP or S.HealthESP or S.NameESP then
		local targets = getValidTargets(CFG.ESP_TeamCheck)
		local activeBoxes = {}
		local myPos = myRoot and myRoot.Position or Camera.CFrame.Position

		for _, target in ipairs(targets) do
			local hrp = target.RootPart
			local hum = target.Humanoid
			local model = target.Model
			if hrp and hum and checkDistance(hrp, CFG.ESP_MaxDist) then
				local visible = isVisible(hrp)
				if not (CFG.ESP_WallCheck and not visible) then
					local topPos, onTop = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0, 3.2, 0))
					local botPos, onBot = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.5, 0))
					if (onTop or onBot) and topPos.Z > 0 and botPos.Z > 0 then
						activeBoxes[model] = true
						local bData = getOrCreateBoxData(model)
						local height = math.abs(botPos.Y - topPos.Y)
						local width = height * 0.58
						
						bData.Container.Position = UDim2.fromOffset(topPos.X - width / 2, topPos.Y)
						bData.Container.Size = UDim2.fromOffset(width, height)
						bData.Container.Visible = true
						
						local col = target.IsPlayer and (visible and CFG.Color_PlayerVisible or CFG.Color_PlayerHidden) or (visible and CFG.Color_BotVisible or CFG.Color_BotHidden)
						bData.Stroke.Enabled = S.BoxESP
						bData.Stroke.Color = col
						
						bData.HpBG.Visible = S.HealthESP
						if S.HealthESP then
							local hpRatio = math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1)
							bData.HpFill.Size = UDim2.new(1, 0, hpRatio, 0)
							bData.HpFill.BackgroundColor3 = Color3.fromHSV(hpRatio * 0.33, 0.9, 1)
						end
						
						bData.NameLbl.Visible = S.NameESP
						if S.NameESP then
							local dist = math.floor((myPos - hrp.Position).Magnitude)
							bData.NameLbl.Text = string.format("%s [%dm]", target.Name, dist)
							bData.NameLbl.TextColor3 = col
						end
					end
				end
			end
		end
		for model, _ in pairs(boxPool) do
			if not activeBoxes[model] then clearBoxData(model) end
		end
	else
		for model, _ in pairs(boxPool) do clearBoxData(model) end
	end

	-- 3. Look-Vector Laser ESP
	if S.LookLaserESP then
		local targets = getValidTargets(CFG.ESP_TeamCheck)
		local activeLasers = {}
		for _, target in ipairs(targets) do
			local model = target.Model
			local head = model:FindFirstChild("Head") or target.RootPart
			if head and checkDistance(head, CFG.ESP_MaxDist) then
				local p1, on1 = Camera:WorldToViewportPoint(head.Position)
				local p2, on2 = Camera:WorldToViewportPoint(head.Position + head.CFrame.LookVector * 8)
				if (on1 or on2) and p1.Z > 0 and p2.Z > 0 then
					activeLasers[model] = true
					local lf = lookLaserFrames[model]
					if not lf then
						lf = Instance.new("Frame")
						lf.AnchorPoint = Vector2.new(0.5, 0.5)
						lf.BorderSizePixel = 0
						lf.Parent = DrawLayer
						lookLaserFrames[model] = lf
					end
					drawLineUI(lf, Vector2.new(p1.X, p1.Y), Vector2.new(p2.X, p2.Y), Color3.fromRGB(255, 50, 80), 1.8)
				end
			end
		end
		for model, lf in pairs(lookLaserFrames) do
			if not model or not model.Parent or not activeLasers[model] then
				if lf then lf:Destroy() end
				lookLaserFrames[model] = nil
			end
		end
	else
		for model, lf in pairs(lookLaserFrames) do
			if lf then lf:Destroy() end
			lookLaserFrames[model] = nil
		end
	end

	-- 4. Skeleton ESP
	if S.Skeleton then
		local targets = getValidTargets(CFG.SkeletonTeamCheck)
		local activeSkeletons = {}
		for _, target in ipairs(targets) do
			if checkDistance(target.RootPart, CFG.Skeleton_MaxDist) then
				local model = target.Model
				local visible = isVisible(target.RootPart)
				if not (CFG.Skeleton_WallCheck and not visible) then
					activeSkeletons[model] = true
					local col = target.IsPlayer and (visible and CFG.Color_PlayerVisible or CFG.Color_PlayerHidden) or (visible and CFG.Color_BotVisible or CFG.Color_BotHidden)
					updateSkeletonForModel(model, col)
				end
			end
		end
		for model, _ in pairs(skeletonPool) do
			if not activeSkeletons[model] then clearSkeleton(model) end
		end
	else
		for model, _ in pairs(skeletonPool) do clearSkeleton(model) end
	end

	-- 5. Tracers
	if S.Tracers then
		local targets = getValidTargets(CFG.TracerTeamCheck)
		local activeKeys = {}
		local originScreen = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

		for _, target in ipairs(targets) do
			local hrp = target.RootPart
			local model = target.Model
			if hrp and checkDistance(hrp, CFG.Tracer_MaxDist) then
				local visible = isVisible(hrp)
				if not (CFG.Tracer_WallCheck and not visible) then
					local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
					if onScreen and screenPos.Z > 0 then
						activeKeys[model] = true
						local lf = tracerFrames[model]
						if not lf then
							lf = Instance.new("Frame")
							lf.AnchorPoint = Vector2.new(0.5, 0.5)
							lf.BorderSizePixel = 0
							lf.Parent = DrawLayer
							tracerFrames[model] = lf
						end
						local col = target.IsPlayer and (visible and CFG.Color_PlayerVisible or CFG.Color_PlayerHidden) or (visible and CFG.Color_BotVisible or CFG.Color_BotHidden)
						drawLineUI(lf, originScreen, Vector2.new(screenPos.X, screenPos.Y), col, 1.4)
					end
				end
			end
		end
		for model, lf in pairs(tracerFrames) do
			if not model or not model.Parent or not activeKeys[model] then
				if lf then lf:Destroy() end
				tracerFrames[model] = nil
			end
		end
	else
		for model, lf in pairs(tracerFrames) do
			if lf then lf:Destroy() end
			tracerFrames[model] = nil
		end
	end

	-- 6. Aimbot & Target HUD
	local lockedTarget = nil
	if S.Aimbot and not S.Freecam then
		local targets = getValidTargets(CFG.AimTeamCheck)
		local closestPart = nil
		local shortestDist = CFG.AimFOV
		local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

		for _, target in ipairs(targets) do
			local model = target.Model
			local part = model:FindFirstChild(CFG.AimPart)
			if not part and CFG.AimPart == "Torso" then
				part = model:FindFirstChild("UpperTorso") or model:FindFirstChild("LowerTorso")
			end
			part = part or target.RootPart

			if part and checkDistance(part, CFG.Aim_MaxDist) then
				local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
				if onScreen and screenPos.Z > 0 then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
					if dist < shortestDist then
						if not CFG.Aim_WallCheck or isVisible(part) then
							shortestDist = dist
							closestPart = part
							lockedTarget = target
						end
					end
				end
			end
		end

		if closestPart and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			local targetPos = closestPart.Position
			if CFG.AimPrediction then
				local targetRoot = closestPart.Parent:FindFirstChild("HumanoidRootPart") or closestPart
				if targetRoot and targetRoot:IsA("BasePart") then
					targetPos = targetPos + (targetRoot.AssemblyLinearVelocity * CFG.PredictionFactor)
				end
			end

			local goalCF = CFrame.new(Camera.CFrame.Position, targetPos)
			if CFG.AimSmoothness > 1 then
				local alpha = math.clamp((dt * 60) / CFG.AimSmoothness, 0.05, 1)
				Camera.CFrame = Camera.CFrame:Lerp(goalCF, alpha)
			else
				Camera.CFrame = goalCF
			end
		end
	end

	if S.Aimbot and S.TargetHUD and lockedTarget and lockedTarget.Humanoid then
		TargetHUDFrame.Visible = true
		local hum = lockedTarget.Humanoid
		local dist = myRoot and math.floor((myRoot.Position - lockedTarget.RootPart.Position).Magnitude) or 0
		thudTitle.Text = "TARGET: " .. tostring(lockedTarget.Name)
		thudSub.Text = string.format("HP: %d/%d | DIST: %dm", math.floor(hum.Health), math.floor(hum.MaxHealth), dist)
		local ratio = math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1)
		thudBarFill.Size = UDim2.new(ratio, 0, 1, 0)
		thudBarFill.BackgroundColor3 = Color3.fromHSV(ratio * 0.33, 0.9, 1)
	else
		TargetHUDFrame.Visible = false
	end
end)

