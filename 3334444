	EmojiBG.Parent = minimized and nil or P
	if minimized then
		MinBtn.Text = "+"
		P.Size = UDim2.new(0, 340, 0, 32)
	else
		MinBtn.Text = "-"
		P.Size = UDim2.new(0, 340, 0, 560)
	end
end)

local draggingWindow, dragStart, startPos = false, nil, nil
TB.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		draggingWindow = true
		dragStart = input.Position
		startPos = P.Position
	end
end)

bindConnection(UIS.InputChanged, function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		if activeSliderUpdate then
			activeSliderUpdate(input.Position)
		elseif draggingWindow then
			local delta = input.Position - dragStart
			P.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
		end
	end
end)

bindConnection(UIS.InputEnded, function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		activeSliderUpdate = nil
		draggingWindow = false
	end
end)

bindConnection(UIS.InputBegan, function(input, gp)
	if bindingFeatureName then
		if input.UserInputType == Enum.UserInputType.Keyboard then
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
				Keybinds[bindingFeatureName] = nil
				if _G.BaggetBinds[bindingFeatureName] then _G.BaggetBinds[bindingFeatureName].updateBtn(nil) end
			else
				Keybinds[bindingFeatureName] = input.KeyCode
				if _G.BaggetBinds[bindingFeatureName] then _G.BaggetBinds[bindingFeatureName].updateBtn(input.KeyCode) end
			end
			bindingFeatureName = nil
		end
		return
	end

	-- Игнорируем нажатия клавиш, если открыт чат или поле ввода
	if UIS:GetFocusedTextBox() then return end

	if not gp and input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode == Enum.KeyCode.RightShift then
			P.Visible = not P.Visible
			return
		end
		if input.KeyCode == Enum.KeyCode.Space and S.InfiniteJump then
			local h = getHum()
			if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
		end
		if input.KeyCode == Enum.KeyCode.V then
			performDash()
		end
		
		-- BTools Горячие клавиши (при зажатом Alt)
		if S.BToolsHotkeys and (UIS:IsKeyDown(Enum.KeyCode.LeftAlt) or UIS:IsKeyDown(Enum.KeyCode.RightAlt)) then
			local t = Mouse.Target
			if t and not t:IsDescendantOf(getChar()) then
				if input.KeyCode == Enum.KeyCode.R then
					t:Destroy()
				elseif input.KeyCode == Enum.KeyCode.C then
					local cl = trackPart(t:Clone())
					cl.Parent = t.Parent
					cl.CFrame = t.CFrame + Vector3.new(0, t.Size.Y, 0)
				elseif input.KeyCode == Enum.KeyCode.A then
					t.Anchored = not t.Anchored
				end
			end
		end

		for name, key in pairs(Keybinds) do
			if key == input.KeyCode and _G.BaggetBinds and _G.BaggetBinds[name] then
				_G.BaggetBinds[name].trigger()
			end
		end
	end

	-- Телепорт по клику (Ctrl + ЛКМ)
	if S.CtrlClickTP and input.UserInputType == Enum.UserInputType.MouseButton1 then
		if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl) then
			local r = getRoot()
			if r and Mouse and Mouse.Hit then
				r.CFrame = CFrame.new(Mouse.Hit.Position + Vector3.new(0, getGroundOffset(), 0))
			end
		end
	end

	-- Физический импульс по клику (Alt + ЛКМ)
	if S.AltClickImpulse and input.UserInputType == Enum.UserInputType.MouseButton1 then
		if UIS:IsKeyDown(Enum.KeyCode.LeftAlt) or UIS:IsKeyDown(Enum.KeyCode.RightAlt) then
			if Mouse and Mouse.Target and not Mouse.Target.Anchored then
				local dir = (Mouse.Hit.Position - Camera.CFrame.Position).Unit
				Mouse.Target.AssemblyLinearVelocity = dir * 140 + Vector3.new(0, 60, 0)
			end
		end
	end
end)

